{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist/types",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/tests"]
}